---
import { Reveal, TechIcon } from '@portfolio/ui';
import Section from './Section.astro';
import { skills } from '../../data/site';

// No groups yet: omit the section entirely instead of rendering an empty shell.
---
{
  skills.length > 0 && (
    <Section label="skills" number="04" title="Technical arsenal & stack.">
      <Reveal client:visible>
        <dl class="space-y-8">
          {skills.map((group) => (
            <div class="grid gap-3 md:grid-cols-[9rem_1fr] md:gap-8 md:items-start">
              <dt class="pt-1 font-sans-display text-sm font-medium text-text-primary">
                {group.category}
              </dt>
              <dd class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="inline-flex items-center gap-1.5 rounded-md border border-border-subtle bg-bg-raised/50 px-2.5 py-1 font-mono-code text-xs text-text-muted transition-colors hover:border-text-muted hover:text-text-primary">
                    <TechIcon name={item} size={13} className="shrink-0 text-text-muted" />
                    <span>{item}</span>
                  </span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </Reveal>
    </Section>
  )
}

