---
import Section from './Section.astro';
import ContributionGrid from '../islands/ContributionGrid';
---
{/* The island is a sibling of the slot content, never wrapped in a Reveal:
    Reveal swaps its child element post-hydration, which would remount the
    grid and re-fetch the activity endpoint. */}
<Section label="activity" headingId="activity">
  <ContributionGrid client:visible />
</Section>
