---
import '@fontsource-variable/space-grotesk';
import '@fontsource/instrument-serif';
import '@fontsource-variable/jetbrains-mono';
import type { Locale, TranslationDictionary } from '../i18n';
import { getAlternateLocale, getTranslations } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  alternatePath?: string;
  dict?: TranslationDictionary;
}

const SITE = 'https://dagadev.net';
const {
  title,
  locale = 'en',
  alternatePath,
} = Astro.props;

const dict = Astro.props.dict ?? getTranslations(locale);
const description = Astro.props.description ?? dict.meta.description;

const targetLocale = getAlternateLocale(locale);
const targetPath = alternatePath ?? (targetLocale === 'es' ? '/es' : '/');
const navPrefix = locale === 'es' ? '/es' : '';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={locale === 'es' ? `${SITE}/es` : `${SITE}/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/`} />
    <link rel="alternate" hreflang="es" href={`${SITE}/es`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <meta property="og:locale" content={dict.meta.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
    <!-- Pending manual asset: public/og-default.png (1200x630). Not generated yet. -->
    <meta property="og:image" content={`${SITE}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Keep in sync with resolveInitialTheme in src/lib/theme.ts.
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored === 'dark' || ((stored !== 'light') && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch {} // localStorage may be blocked in private mode
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-border-subtle focus:bg-bg-raised focus:px-4 focus:py-2 focus:text-sm focus:text-text-primary"
    >
      {dict.nav.skipToContent}
    </a>
    <header
      id="site-header"
      class="sticky top-0 z-40 w-full border-b border-transparent bg-transparent py-4 transition-all duration-200 data-[scrolled=true]:border-border-subtle/80 data-[scrolled=true]:bg-bg/85 data-[scrolled=true]:py-3 data-[scrolled=true]:shadow-xs data-[scrolled=true]:backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-3xl items-center justify-between px-6">
        <a href={locale === 'es' ? '/es' : '/'} class="font-mono-code text-xs font-medium text-text-muted transition-colors hover:text-text-primary">
          dagadev.net
        </a>

        <!-- Desktop Navigation -->
        <nav aria-label="Main" class="hidden items-center gap-5 md:flex">
          <a href={`${navPrefix}#about`} class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.about}</a>
          <a href={`${navPrefix}#experience`} class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.experience}</a>
          <a href={`${navPrefix}#skills`} class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.skills}</a>
          <a href={`${navPrefix}#projects`} class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.projects}</a>
          <a href={`${navPrefix}#activity`} class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.activity}</a>
          <a href="/blog/" class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.blog}</a>
          <a href={`${navPrefix}#contact`} class="font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary">{dict.nav.contact}</a>
          <a
            href={targetPath}
            data-lang-toggle
            class="flex h-7 items-center gap-1 rounded-md border border-transparent px-1.5 font-mono-code text-[11px] font-medium text-text-muted transition-colors hover:border-border-subtle hover:bg-bg-raised hover:text-text-primary"
            aria-label={dict.nav.toggleLanguageLabel}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
            </svg>
            <span class="uppercase">{targetLocale}</span>
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="flex size-7 items-center justify-center rounded-md border border-transparent text-text-muted transition-colors hover:border-border-subtle hover:bg-bg-raised hover:text-text-primary"
            aria-label={dict.nav.toggleThemeLabel}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
          </button>
        </nav>

        <!-- Mobile Controls -->
        <div class="flex items-center gap-2 md:hidden">
          <a
            href={targetPath}
            data-lang-toggle
            class="flex size-8 items-center justify-center rounded-md border border-border-subtle/80 bg-bg/80 font-mono-code text-xs font-medium text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary"
            aria-label={dict.nav.toggleLanguageLabel}
          >
            <span class="uppercase">{targetLocale}</span>
          </a>

          <button
            id="theme-toggle-mobile"
            type="button"
            class="flex size-8 items-center justify-center rounded-md border border-border-subtle/80 bg-bg/80 text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary"
            aria-label={dict.nav.toggleThemeLabel}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
          </button>

          <button
            id="mobile-menu-btn"
            type="button"
            class="flex size-8 items-center justify-center rounded-md border border-border-subtle/80 bg-bg/80 text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
          >
            <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
            </svg>
            <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div
        id="mobile-menu"
        class="hidden px-6 pt-3 pb-2 md:hidden"
        aria-hidden="true"
      >
        <nav class="mx-auto flex max-w-3xl flex-col divide-y divide-border-subtle/50 rounded-xl border border-border-subtle/80 bg-bg/95 p-2 shadow-xl backdrop-blur-2xl">
          <a href={`${navPrefix}#about`} class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary">{dict.nav.about}</a>
          <a href={`${navPrefix}#experience`} class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary">{dict.nav.experience}</a>
          <a href={`${navPrefix}#skills`} class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary">{dict.nav.skills}</a>
          <a href={`${navPrefix}#projects`} class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary">{dict.nav.projects}</a>
          <a href={`${navPrefix}#activity`} class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary">{dict.nav.activity}</a>
          <a href="/blog/" class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs text-text-muted transition-colors hover:bg-bg-raised hover:text-text-primary">{dict.nav.blog}</a>
          <a href={`${navPrefix}#contact`} class="mobile-nav-link rounded-lg px-3 py-2.5 font-mono-code text-xs font-medium text-accent-readable transition-colors hover:bg-bg-raised hover:underline">{dict.nav.contactCta}</a>
        </nav>
      </div>
    </header>
    <script is:inline>
      // Sticky header scroll detection, mobile menu, theme toggle persistence, & language toggle hash preservation
      (() => {
        const header = document.getElementById('site-header');
        if (header) {
          const updateScroll = () => {
            header.setAttribute('data-scrolled', window.scrollY > 15 ? 'true' : 'false');
          };
          window.addEventListener('scroll', updateScroll, { passive: true });
          updateScroll();
        }

        // Mobile Burger Menu
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');

        if (menuBtn && mobileMenu && iconOpen && iconClose) {
          const toggleMenu = (open) => {
            const isOpen = typeof open === 'boolean' ? open : mobileMenu.classList.contains('hidden');
            if (isOpen) {
              mobileMenu.classList.remove('hidden');
              menuBtn.setAttribute('aria-expanded', 'true');
              mobileMenu.setAttribute('aria-hidden', 'false');
              iconOpen.classList.add('hidden');
              iconClose.classList.remove('hidden');
            } else {
              mobileMenu.classList.add('hidden');
              menuBtn.setAttribute('aria-expanded', 'false');
              mobileMenu.setAttribute('aria-hidden', 'true');
              iconOpen.classList.remove('hidden');
              iconClose.classList.add('hidden');
            }
          };

          menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleMenu();
          });

          // Close on clicking any link inside mobile menu
          mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
            link.addEventListener('click', () => toggleMenu(false));
          });

          // Close on clicking outside
          document.addEventListener('click', (e) => {
            if (!header.contains(e.target)) {
              toggleMenu(false);
            }
          });

          // Close on Escape
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') toggleMenu(false);
          });
        }

        // Theme Toggle handlers (Desktop & Mobile)
        const toggleTheme = () => {
          const next = document.documentElement.classList.toggle('dark') ? 'dark' : 'light';
          try {
            localStorage.setItem('theme', next);
          } catch {}
        };

        const btnDesktop = document.getElementById('theme-toggle');
        const btnMobile = document.getElementById('theme-toggle-mobile');
        if (btnDesktop) btnDesktop.addEventListener('click', toggleTheme);
        if (btnMobile) btnMobile.addEventListener('click', toggleTheme);

        // Language Toggle handlers (Desktop & Mobile)
        document.querySelectorAll('[data-lang-toggle]').forEach((el) => {
          el.addEventListener('click', (e) => {
            const targetBase = el.getAttribute('href') || '/';
            const hash = window.location.hash;
            if (hash) {
              e.preventDefault();
              const cleanBase = targetBase === '/' ? '' : targetBase.replace(/\/$/, '');
              window.location.href = `${cleanBase}${hash.startsWith('#') ? hash : '#' + hash}`;
            }
          });
        });
      })();
    </script>
    <slot />
  </body>
</html>
