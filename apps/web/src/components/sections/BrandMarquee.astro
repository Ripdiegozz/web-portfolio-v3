---
interface Props {
  kicker?: string;
}

const { kicker = "TEAMS & CLIENTS I'VE WORKED WITH" } = Astro.props;

const brands = [
  {
    name: 'Wazuh',
    href: 'https://wazuh.com',
    src: '/brands/wazuh.png',
    imgClass: 'h-5 sm:h-6.5 w-auto max-w-[135px] object-contain dark:invert dark:brightness-150 opacity-60 group-hover:opacity-100 transition-all duration-300',
  },
  {
    name: 'Stanley Black & Decker',
    href: 'https://www.stanleyblackanddecker.com',
    src: '/brands/stanley.png',
    imgClass: 'h-7 sm:h-8.5 w-auto max-w-[180px] object-contain grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300',
  },
  {
    name: 'Tres Pi Medios',
    href: 'https://www.trespimedios.co/',
    src: '/brands/trespi.png',
    imgClass: 'h-6 sm:h-7.5 w-auto max-w-[145px] object-contain invert dark:invert-0 opacity-60 group-hover:opacity-100 transition-all duration-300',
  },
  {
    name: 'SuperGIROS',
    href: 'https://www.supergiros.com.co',
    src: '/brands/superg.png',
    imgClass: 'h-6 sm:h-7.5 w-auto max-w-[150px] object-contain invert dark:invert-0 opacity-60 group-hover:opacity-100 transition-all duration-300',
  },
];
---

<section class="relative w-full border-y border-border-subtle/40 bg-bg-raised/20 py-7 backdrop-blur-2xs">
  <div class="mx-auto max-w-3xl px-6">
    <p class="mb-5 text-center font-mono-code text-[11px] font-semibold tracking-widest text-text-muted/70 uppercase">
      {kicker}
    </p>

    <!-- Static Balanced Grid: Real Logo Assets -->
    <div class="grid grid-cols-2 items-center justify-items-center gap-6 sm:grid-cols-4 sm:gap-8">
      {
        brands.map((brand) => (
          <a
            href={brand.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-center rounded-lg p-2 transition-transform duration-200 hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label={`Visit ${brand.name}`}
          >
            <img
              src={brand.src}
              alt={brand.name}
              class={brand.imgClass}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
