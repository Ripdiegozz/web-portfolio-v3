---
import { User, Sparkles, Code2, Terminal, Cpu, Mail, FileText } from '@portfolio/ui';

interface Props {
  /** Section slug used for the aria id pair; also the kicker label. */
  label: string;
  number?: string;
  title?: string;
  description?: string;
}

const { label, number, title, description } = Astro.props;

const ICONS = {
  about: User,
  experience: Sparkles,
  projects: Code2,
  activity: Terminal,
  skills: Cpu,
  writing: FileText,
  blog: FileText,
  contact: Mail,
} as const;

const IconComponent = ICONS[label as keyof typeof ICONS] ?? Sparkles;
---
<section id={label} aria-labelledby={`${label}-heading`} class="scroll-mt-16 sm:scroll-mt-20 border-t border-border-subtle/80">
  <div class="mx-auto w-full max-w-3xl px-6 py-20 md:py-28">
    <!-- Header: Badge Kicker + Display Title + Gradient Accent Line -->
    <header class="mb-10">
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center gap-2 rounded-full border border-border-subtle/80 bg-bg-raised/70 px-3 py-1 font-mono-code text-xs text-text-muted shadow-2xs backdrop-blur-xs">
          {number && <span class="text-text-muted/60">{number}</span>}
          {number && <span class="text-border-subtle" aria-hidden="true">•</span>}
          <IconComponent className="size-3.5 text-accent" />
          <span class="font-medium text-text-primary capitalize">{label}</span>
        </div>
        <div class="h-px flex-1 bg-gradient-to-r from-border-subtle/80 via-border-subtle/30 to-transparent" aria-hidden="true" />
      </div>

      {title && (
        <h2
          id={`${label}-heading`}
          class="mt-4 font-sans-display text-2xl font-medium tracking-tight text-text-primary sm:text-3xl md:text-4xl"
        >
          {title}
        </h2>
      )}
      {description && (
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-muted">
          {description}
        </p>
      )}
    </header>

    <slot />
  </div>
</section>

