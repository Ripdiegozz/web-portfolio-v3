---
interface Props {
  id?: string;
  label: string; // mono kicker text, lowercased
  headingId: string; // unique id used for aria-labelledby
}
const { id, label, headingId } = Astro.props;
---
<section id={id} aria-labelledby={`${headingId}-heading`} class="border-t border-border-subtle">
  <div class="mx-auto w-full max-w-3xl px-6 py-24 md:py-32">
    <h2 id={`${headingId}-heading`} class="font-mono-code text-xs tracking-[0.2em] text-text-muted">
      <span aria-hidden="true">//</span> {label}
    </h2>
    <slot />
  </div>
</section>
