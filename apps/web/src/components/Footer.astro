---
import { SiGithub, SiLinkedin, FileText, ArrowUpRight } from '@portfolio/ui';
import type { FooterTranslations, SocialLink } from '../i18n';
import { en } from '../i18n/locales/en';
import { socials as defaultSocials } from '../data/site';

interface Props {
  dict?: FooterTranslations;
  socials?: SocialLink[];
}

const {
  dict = en.footer,
  socials = dict.socials ?? defaultSocials,
} = Astro.props;

const year = new Date().getFullYear();
const copyrightText = dict.copyright.replace('{year}', String(year));
---
<footer class="border-t border-border-subtle">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-6 py-10 md:flex-row md:items-center md:justify-between">
    <ul class="flex flex-wrap items-center gap-6">
      {socials.map((social) => {
        const isGithub = social.label.toLowerCase() === 'github';
        const isLinkedin = social.label.toLowerCase() === 'linkedin';
        const isCv = social.label.toLowerCase() === 'cv';
        return (
          <li>
            <a
              href={social.href}
              class="group inline-flex items-center gap-1.5 font-mono-code text-xs text-text-muted transition-colors hover:text-text-primary"
              rel="noopener noreferrer"
              target="_blank"
            >
              {isGithub && <SiGithub size={13} className="text-text-muted transition-colors group-hover:text-text-primary" />}
              {isLinkedin && <SiLinkedin size={13} className="text-text-muted transition-colors group-hover:text-text-primary" />}
              {isCv && <FileText className="size-3.5 text-text-muted transition-colors group-hover:text-text-primary" />}
              <span>{social.label.toLowerCase()}</span>
              <ArrowUpRight className="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
        );
      })}
    </ul>
    <p class="font-mono-code text-xs text-text-muted">{copyrightText}</p>
  </div>
</footer>
