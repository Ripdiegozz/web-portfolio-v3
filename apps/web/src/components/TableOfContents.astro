---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
  label?: string;
}

const { headings, label = 'On this page' } = Astro.props;

// Only show h2 and h3
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filtered.length > 1 && (
  <nav aria-label={label} class="toc">
    <!-- Mobile: collapsible -->
    <details class="mb-8 rounded-lg border border-border-subtle bg-bg-raised/50 px-4 py-3 lg:hidden">
      <summary class="cursor-pointer select-none font-mono-code text-xs font-medium uppercase tracking-widest text-text-muted">
        {label}
      </summary>
      <ol class="mt-3 space-y-1.5 pl-0">
        {filtered.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="font-mono-code text-xs leading-relaxed text-text-muted transition-colors hover:text-text-primary"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>

    <!-- Desktop: sticky sidebar -->
    <aside class="sticky top-24 hidden max-h-[calc(100vh-8rem)] overflow-y-auto lg:block">
      <p class="mb-3 font-mono-code text-[10px] font-medium uppercase tracking-widest text-text-muted">
        {label}
      </p>
      <ol class="space-y-1.5 border-l border-border-subtle pl-4">
        {filtered.map((h) => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link
              class="toc-link block font-mono-code text-xs leading-relaxed text-text-muted transition-colors hover:text-text-primary"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </aside>
  </nav>
)}

<script>
  // Highlight active heading while scrolling
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const headingEls = Array.from(links)
      .map((l) => document.getElementById(l.getAttribute('href')!.slice(1)))
      .filter(Boolean) as HTMLElement[];

    const highlight = () => {
      const scrollY = window.scrollY + 128; // matches prose-headings:scroll-mt-28
      let current = headingEls[0];
      for (const el of headingEls) {
        if (el.offsetTop <= scrollY) current = el;
      }
      links.forEach((l) => {
        const active = l.getAttribute('href') === `#${current?.id}`;
        l.classList.toggle('text-text-primary', active);
        l.classList.toggle('text-text-muted', !active);
      });
    };

    window.addEventListener('scroll', highlight, { passive: true });
    highlight();
  }
</script>
