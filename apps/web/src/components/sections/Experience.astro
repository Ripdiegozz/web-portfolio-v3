---
import { Reveal } from '@portfolio/ui';
import Section from './Section.astro';
import { experience } from '../../data/site';
---
<Section label="experience">
  <Reveal client:visible>
    <ul class="mt-12 divide-y divide-border-subtle">
      {experience.map((job) => (
        <li class="grid gap-3 py-10 first:pt-0 last:pb-0 md:grid-cols-[9rem_1fr] md:gap-8">
          <p class="flex items-center gap-2 font-mono-code text-xs text-text-muted">
            {job.current && (
              <span class="size-1.5 animate-pulse rounded-full bg-accent" aria-hidden="true"></span>
            )}
            {job.period}
          </p>
          <div>
            <h3 class="font-sans-display text-xl font-medium text-text-primary">{job.role}</h3>
            <p class="mt-1 text-text-muted">{job.company}</p>
            {job.highlights.length > 0 && (
              <ul class="mt-4 space-y-1.5">
                {job.highlights.map((highlight) => (
                  <li class="text-sm leading-relaxed text-text-muted">{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </Reveal>
</Section>
