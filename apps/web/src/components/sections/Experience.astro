---
import Section from './Section.astro';
import ExperienceDashboard from '../islands/ExperienceDashboard';
import type { ExperienceTranslations } from '../../i18n';
import { en } from '../../i18n/locales/en';

interface Props {
  dict?: ExperienceTranslations;
}

const { dict = en.experience } = Astro.props;
---
<Section label="experience" number="02" title={dict.sectionTitle}>
  <ExperienceDashboard
    client:visible
    items={dict.items}
    labels={{
      active: dict.activeLabel,
      at: dict.atLabel,
      clientLabel: dict.clientLabel,
      keyContributions: dict.contributionsHeading,
      technologies: dict.technologiesHeading,
      tablistAriaLabel: dict.tablistAriaLabel,
    }}
  />
</Section>
