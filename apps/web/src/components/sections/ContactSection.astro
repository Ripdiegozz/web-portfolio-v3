---
import { Reveal } from '@portfolio/ui';
---
<section id="contact" aria-labelledby="contact-heading" class="border-t border-border-subtle">
  <Reveal client:visible>
    <div class="mx-auto w-full max-w-3xl px-6 py-24 md:py-32">
      <h2 id="contact-heading" class="font-mono-code text-xs tracking-[0.2em] text-text-muted">// contact</h2>
      <p class="mt-10 font-sans-display text-4xl font-medium tracking-tight text-text-primary md:text-5xl">
        Let's build something.
      </p>
      {/* The contact form island hydrates here in a later task. */}
      <div id="contact-form-root"></div>
      <p class="mt-12 font-mono-code text-xs text-text-muted">
        prefer email?
        <a
          href="mailto:hello@dagadev.tech"
          class="underline decoration-border-subtle underline-offset-4 transition-colors hover:text-text-primary"
        >
          hello@dagadev.tech
        </a>
      </p>
    </div>
  </Reveal>
</section>
