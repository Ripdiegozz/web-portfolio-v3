---
import { Reveal, TechIcon, Sparkles, Layers, Cpu, Shield } from '@portfolio/ui';
import Section from './Section.astro';
import type { SkillsTranslations } from '../../i18n';
import { en } from '../../i18n/locales/en';

interface Props {
  dict?: SkillsTranslations;
}

const { dict = en.skills } = Astro.props;
const [frontendCat, backendCat, devopsCat] = dict.categories;
---

<Section
  label="skills"
  number="03"
  title={dict.sectionTitle}
  description={dict.sectionDescription}
>
  <Reveal client:visible>
    <div class="space-y-6">
      {/* 1. Primary Bento Card: Core Stack & Daily Drivers */}
      <div class="relative overflow-hidden rounded-2xl border border-border-subtle/80 bg-bg-raised/40 p-6 sm:p-8 backdrop-blur-xs">
        <div class="pointer-events-none absolute -right-12 -top-12 size-48 rounded-full bg-accent/5 blur-3xl dark:bg-accent/10" aria-hidden="true" />
        
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border-subtle/40 pb-5">
          <div class="flex items-center gap-2.5">
            <span class="flex size-8 items-center justify-center rounded-lg border border-border-subtle/80 bg-bg/80 text-accent shadow-2xs">
              <Sparkles className="size-4" />
            </span>
            <div>
              <h3 class="font-sans-display text-base font-medium text-text-primary">
                {dict.coreStackTitle}
              </h3>
              <p class="font-mono-code text-[11px] text-text-muted">
                {dict.coreStackSubtitle}
              </p>
            </div>
          </div>
        </div>

        {/* Featured Core Tech Grid */}
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
          {dict.coreSkills.map((skill) => (
            <div
              class="group relative flex flex-col justify-between rounded-xl border border-border-subtle/70 bg-bg/70 p-3.5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:bg-bg-raised hover:shadow-xs"
            >
              <div class="flex items-center justify-between">
                <TechIcon name={skill.name} size={20} className="text-text-muted transition-transform group-hover:scale-110 group-hover:text-text-primary" />
              </div>
              <div class="mt-3">
                <span class="block font-mono-code text-xs font-semibold text-text-primary">
                  {skill.name}
                </span>
                <span class="block font-mono-code text-[10px] text-text-muted">
                  {skill.role}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* 2. Middle Row: 2 Balanced Wide Columns for Frontend & Backend */}
      <div class="grid gap-6 md:grid-cols-2">
        {/* Frontend Card */}
        {frontendCat && (
          <div class="flex flex-col justify-between rounded-2xl border border-border-subtle/80 bg-bg-raised/30 p-6 backdrop-blur-xs transition-colors hover:border-border-subtle hover:bg-bg-raised/50">
            <div>
              <div class="flex items-center gap-2.5 border-b border-border-subtle/40 pb-4">
                <span class="flex size-7 items-center justify-center rounded-lg border border-border-subtle/80 bg-bg/80 text-text-primary shadow-2xs">
                  <Layers className="size-3.5 text-accent" />
                </span>
                <div>
                  <h4 class="font-sans-display text-sm font-medium text-text-primary">
                    {frontendCat.title}
                  </h4>
                </div>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-text-muted">
                {frontendCat.description}
              </p>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
              {frontendCat.skills.map((item) => (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-border-subtle/70 bg-bg/70 px-2.5 py-1.5 font-mono-code text-xs text-text-muted transition-colors hover:border-text-muted hover:text-text-primary">
                  <TechIcon name={item} size={13} className="shrink-0 text-text-muted" />
                  <span>{item}</span>
                </span>
              ))}
            </div>
          </div>
        )}

        {/* Backend Card */}
        {backendCat && (
          <div class="flex flex-col justify-between rounded-2xl border border-border-subtle/80 bg-bg-raised/30 p-6 backdrop-blur-xs transition-colors hover:border-border-subtle hover:bg-bg-raised/50">
            <div>
              <div class="flex items-center gap-2.5 border-b border-border-subtle/40 pb-4">
                <span class="flex size-7 items-center justify-center rounded-lg border border-border-subtle/80 bg-bg/80 text-text-primary shadow-2xs">
                  <Cpu className="size-3.5 text-accent" />
                </span>
                <div>
                  <h4 class="font-sans-display text-sm font-medium text-text-primary">
                    {backendCat.title}
                  </h4>
                </div>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-text-muted">
                {backendCat.description}
              </p>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
              {backendCat.skills.map((item) => (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-border-subtle/70 bg-bg/70 px-2.5 py-1.5 font-mono-code text-xs text-text-muted transition-colors hover:border-text-muted hover:text-text-primary">
                  <TechIcon name={item} size={13} className="shrink-0 text-text-muted" />
                  <span>{item}</span>
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* 3. Bottom Row: Full-width DevOps & Testing Horizontal Card */}
      {devopsCat && (
        <div class="rounded-2xl border border-border-subtle/80 bg-bg-raised/30 p-6 backdrop-blur-xs transition-colors hover:border-border-subtle hover:bg-bg-raised/50">
          <div class="grid gap-6 md:grid-cols-[16rem_1fr] md:items-center">
            <div class="border-b border-border-subtle/40 pb-4 md:border-b-0 md:border-r md:pb-0 md:pr-6">
              <div class="flex items-center gap-2.5">
                <span class="flex size-7 items-center justify-center rounded-lg border border-border-subtle/80 bg-bg/80 text-text-primary shadow-2xs">
                  <Shield className="size-3.5 text-accent" />
                </span>
                <h4 class="font-sans-display text-sm font-medium text-text-primary">
                  {devopsCat.title}
                </h4>
              </div>
              <p class="mt-2.5 text-xs leading-relaxed text-text-muted">
                {devopsCat.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              {devopsCat.skills.map((item) => (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-border-subtle/70 bg-bg/70 px-2.5 py-1.5 font-mono-code text-xs text-text-muted transition-colors hover:border-text-muted hover:text-text-primary">
                  <TechIcon name={item} size={13} className="shrink-0 text-text-muted" />
                  <span>{item}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </Reveal>
</Section>
