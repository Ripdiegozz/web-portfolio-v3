---
import { filterTocHeadings, type TocHeading } from '../lib/blog';

export type { TocHeading };

interface Props {
  headings: TocHeading[];
  label?: string;
}

const { headings, label = 'On this page' } = Astro.props;
const filtered = filterTocHeadings(headings);
---

{filtered.length > 1 && (
  <nav aria-label={label} class="toc">
    <!-- Mobile: collapsible dropdown -->
    <details
      class="group rounded-lg border border-border-subtle bg-bg-raised/50 px-4 py-3 lg:hidden"
      data-toc-mobile
    >
      <summary class="flex cursor-pointer select-none items-center justify-between font-mono-code text-xs font-medium uppercase tracking-widest text-text-muted transition-colors hover:text-text-primary">
        <span>{label}</span>
        <svg
          class="size-3.5 transition-transform duration-200 group-open:rotate-180 text-text-muted"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ol class="mt-3 space-y-1.5 border-t border-border-subtle/60 pt-3 pl-0">
        {filtered.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link
              class="toc-link block font-mono-code text-xs leading-relaxed text-text-muted transition-colors hover:text-text-primary data-[active=true]:font-medium data-[active=true]:text-accent-readable"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>

    <!-- Desktop: sidebar list -->
    <div class="hidden max-h-[calc(100vh-8rem)] overflow-y-auto lg:block">
      <p class="mb-3 font-mono-code text-[10px] font-medium uppercase tracking-widest text-text-muted">
        {label}
      </p>
      <ol class="space-y-1.5 border-l border-border-subtle pl-4">
        {filtered.map((h) => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link
              class="toc-link block font-mono-code text-xs leading-relaxed text-text-muted transition-colors hover:text-text-primary data-[active=true]:font-medium data-[active=true]:text-accent-readable"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<script>
  import { findActiveHeading } from '../lib/blog';

  function setupToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;

    // Map unique decoded heading IDs to their DOM elements in document order
    const headingMap = new Map<string, HTMLElement>();
    for (const link of links) {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) continue;
      const id = decodeURIComponent(href.slice(1));
      if (!headingMap.has(id)) {
        const el = document.getElementById(id) || document.querySelector<HTMLElement>(`[id="${CSS.escape(id)}"]`);
        if (el) {
          headingMap.set(id, el);
        }
      }
    }

    const headingEntries = Array.from(headingMap.entries());
    if (headingEntries.length === 0) return;

    let activeId = '';

    function setActive(id: string) {
      if (activeId === id) return;
      activeId = id;
      for (const link of links) {
        const href = link.getAttribute('href');
        const linkId = href ? decodeURIComponent(href.slice(1)) : '';
        const isActive = linkId === id;
        link.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    }

    // Intercept clicks on TOC links for smooth scrolling & mobile menu auto-close
    for (const link of links) {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const id = decodeURIComponent(href.slice(1));
        const target = headingMap.get(id) || document.getElementById(id);
        if (target) {
          e.preventDefault();

          // If inside a mobile details element, close it first so layout does not jump
          const details = link.closest('details');
          if (details && details.open) {
            details.open = false;
          }

          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', '#' + id);
          setActive(id);
        }
      });
    }

    function updateActive() {
      const isBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 40;
      const headingRects = headingEntries.map(([id, el]) => ({
        id,
        top: el.getBoundingClientRect().top,
      }));

      const current = findActiveHeading(headingRects, 110, isBottom);
      setActive(current);
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Initial sync
    updateActive();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupToc);
  } else {
    setupToc();
  }
  document.addEventListener('astro:page-load', setupToc);
</script>
