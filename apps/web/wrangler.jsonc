{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-portfolio-v3",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEZirQtgOSbDAmlZ"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "862754f037ac4c8181c785a0d0f7a60b"
    }
  ],
  "routes": [
    { "pattern": "dagadev.net/*", "zone_name": "dagadev.net" },
    { "pattern": "www.dagadev.net/*", "zone_name": "dagadev.net" }
  ]
}
