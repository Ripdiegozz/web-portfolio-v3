---
import { Reveal } from '@portfolio/ui';
import Section from './Section.astro';
import { projects } from '../../data/site';
---
<Section label="projects" headingId="projects">
  <Reveal client:visible>
    <ul class="mt-12 divide-y divide-border-subtle">
      {projects.map((project) => (
        <li class="py-10 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h3 class="font-sans-display text-xl font-medium text-text-primary">{project.name}</h3>
            {(project.liveUrl || project.repoUrl) && (
              <p class="flex gap-5 font-mono-code text-xs">
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    class="text-accent-readable underline-offset-2 hover:underline"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    live ↗
                  </a>
                )}
                {project.repoUrl && (
                  <a
                    href={project.repoUrl}
                    class="text-text-muted transition-colors hover:text-text-primary"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    source ↗
                  </a>
                )}
              </p>
            )}
          </div>
          <p class="mt-3 max-w-xl leading-relaxed text-text-muted">{project.description}</p>
          {project.stack.length > 0 && (
            <p class="mt-4 font-mono-code text-xs text-text-muted">{project.stack.join(' · ')}</p>
          )}
        </li>
      ))}
    </ul>
  </Reveal>
</Section>
