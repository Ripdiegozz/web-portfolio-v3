---
import { getCollection } from 'astro:content';
import { Reveal } from '@portfolio/ui';
import Section from './Section.astro';
import { isPublished, sortPostsByDateDesc, getReadingTime, formatBlogDate } from '../../lib/blog';
import type { WritingTranslations } from '../../i18n';
import type { Locale } from '../../i18n/types';
import { en } from '../../i18n/locales/en';

interface Props {
  dict?: WritingTranslations;
  locale?: Locale;
}

const { dict = en.writing, locale = 'en' } = Astro.props;

const allPosts = (await getCollection('posts')).filter(isPublished);
const posts = sortPostsByDateDesc(allPosts).slice(0, 3);
---

<Section label="writing" number="06" title={dict.sectionTitle} description={dict.lead}>
  <Reveal client:visible>
    {posts.length === 0 ? (
      <p class="font-mono-code text-sm text-text-muted">{dict.emptyState}</p>
    ) : (
      <ul class="divide-y divide-border-subtle">
        {posts.map((post) => {
          const mins = getReadingTime(post.body ?? '');
          const readTime = dict.readTime.replace('{n}', String(mins));
          const dateStr = formatBlogDate(post.data.pubDate, locale);
          return (
            <li class="group py-8 first:pt-0 last:pb-0">
              <a href={`/blog/${post.id}/`} class="block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="font-sans-display text-lg font-medium text-text-primary transition-colors group-hover:text-accent-readable">
                    {post.data.title}
                  </h3>
                  <span class="shrink-0 font-mono-code text-xs text-text-muted">{readTime}</span>
                </div>

                {post.data.description && (
                  <p class="mt-2 max-w-2xl leading-relaxed text-text-muted line-clamp-2">
                    {post.data.description}
                  </p>
                )}

                <div class="mt-3 flex flex-wrap items-center gap-3">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="font-mono-code text-xs text-text-muted"
                  >
                    {dateStr}
                  </time>

                  {post.data.tags.length > 0 && (
                    <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
                      {post.data.tags.slice(0, 4).map((tag) => (
                        <li class="rounded-md border border-border-subtle bg-bg-raised/60 px-2 py-0.5 font-mono-code text-xs text-text-muted">
                          {tag}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <div class="mt-8">
      <a
        href="/blog/"
        class="inline-flex items-center gap-1.5 font-mono-code text-sm text-accent-readable underline-offset-4 hover:underline"
      >
        {dict.viewAll}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </Reveal>
</Section>
