---
interface Props {
  /** Section slug used for the aria id pair; also the kicker label. */
  label: string;
}
const { label } = Astro.props;
---
<section id={label} aria-labelledby={`${label}-heading`} class="border-t border-border-subtle">
  <div class="mx-auto w-full max-w-3xl px-6 py-24 md:py-32">
    <h2 id={`${label}-heading`} class="font-mono-code text-xs tracking-[0.2em] text-text-muted">
      <span aria-hidden="true">//</span> {label}
    </h2>
    <slot />
  </div>
</section>
