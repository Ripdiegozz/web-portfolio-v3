---
import Section from './Section.astro';
import ContactForm from '../islands/ContactForm';
---
<Section label="contact">
  <!-- No Reveal here: the form must stay stable (no remount on hydration), and
       the section heading follows the shell's static kicker like Activity. -->
  <p class="mt-10 font-sans-display text-4xl font-medium tracking-tight text-text-primary md:text-5xl">
    Let's build something.
  </p>

  <ContactForm client:visible />

  <p class="mt-12 font-mono-code text-xs text-text-muted">
    prefer email?
    <a
      href="mailto:hello@dagadev.net"
      class="underline decoration-border-subtle underline-offset-4 transition-colors hover:text-text-primary"
    >
      hello@dagadev.net
    </a>
  </p>
</Section>
{import.meta.env.PUBLIC_E2E_MOCKS !== '1' && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
)}
