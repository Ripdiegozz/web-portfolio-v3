---
import { Reveal } from '@portfolio/ui';
import Section from './Section.astro';
import { skills } from '../../data/site';

// No groups yet: omit the section entirely instead of rendering an empty shell.
---
{
  skills.length > 0 && (
    <Section label="skills">
      <Reveal client:visible>
        <dl class="mt-12 space-y-10">
          {skills.map((group) => (
            <div class="grid gap-3 md:grid-cols-[9rem_1fr] md:gap-8">
              <dt class="pt-0.5 font-sans-display text-sm font-medium text-text-primary">
                {group.category}
              </dt>
              <dd class="font-mono-code text-xs leading-loose text-text-muted">
                {group.items.join(' · ')}
              </dd>
            </div>
          ))}
        </dl>
      </Reveal>
    </Section>
  )
}
